{
  "name": "cursor-usage",
  "displayName": "Cursor Usage",
  "description": "Shows Cursor subscription usage percent in the status bar",
  "version": "0.0.2",
  "publisher": "camille",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fifaure/cursor-usage.git"
  },
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "build:icons": "node scripts/build-rings.js",
    "package": "vsce package --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/sql.js": "^1.4.9",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "svg2ttf": "^6.1.0",
    "ttf2woff": "^3.0.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "sql.js": "^1.11.0"
  },
